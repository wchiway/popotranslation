<Page
    x:Class="popotranslation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="32,28,32,40" Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Text="PopoTranslation" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="配置翻译语言、快捷键和服务连接。" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="准备就绪" Message="保存设置后，使用快捷键开始翻译。" />

                <Border x:Name="TranslationCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻译" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="选择语言并设置全局快捷键。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="SourceLanguageBox" Header="源语言" PlaceholderText="自动识别（留空）"
                                 AutomationProperties.Name="源语言，留空自动识别" />
                        <TextBox x:Name="TargetLanguageBox" Header="目标语言" PlaceholderText="例如：简体中文、English"
                                 AutomationProperties.Name="目标语言" />
                        <TextBox x:Name="StyleBox" Header="翻译风格（可选）" PlaceholderText="例如：自然、简洁"
                                 AutomationProperties.Name="翻译风格" />
                        <TextBox x:Name="SelectionHotkeyBox" Header="翻译选中文字" PlaceholderText="例如：Ctrl+Alt+F9"
                                 AutomationProperties.Name="翻译选中文字快捷键" />
                        <TextBox x:Name="WholeHotkeyBox" Header="翻译整个输入框" PlaceholderText="例如：Ctrl+Alt+F10"
                                 AutomationProperties.Name="翻译整个输入框快捷键" />
                        <TextBlock Text="快捷键格式：Ctrl、Alt 或 Shift 加一个字母、数字或功能键（F12 除外）。注册冲突将在保存时提示。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ServiceCard" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻译服务" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="设置当前使用的服务和模型。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ProfilesBox" Header="当前服务" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="当前服务" SelectionChanged="Profiles_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AddProfileButton" Content="新增服务" Click="AddProfile_Click" />
                            <Button x:Name="DeleteProfileButton" Content="删除服务" Click="DeleteProfile_Click" />
                        </StackPanel>
                        <TextBox x:Name="NameBox" Header="服务名称" PlaceholderText="例如：我的翻译服务"
                                 AutomationProperties.Name="服务名称" />
                        <ComboBox x:Name="ProtocolBox" Header="服务类型" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="服务类型" SelectedIndex="0">
                            <ComboBoxItem Content="OpenAI Chat Completions" Tag="OpenAiChatCompletions" />
                            <ComboBoxItem Content="OpenAI Responses" Tag="OpenAiResponses" />
                            <ComboBoxItem Content="Anthropic Messages" Tag="AnthropicMessages" />
                            <ComboBoxItem Content="Gemini generateContent" Tag="GeminiGenerateContent" />
                        </ComboBox>
                        <TextBox x:Name="BaseUrlBox" Header="Base URL" PlaceholderText="留空使用官方默认地址"
                                 InputScope="Url" AutomationProperties.Name="服务基础地址" />
                        <TextBox x:Name="ModelBox" Header="模型 ID" PlaceholderText="输入服务支持的模型 ID"
                                 AutomationProperties.Name="模型 ID" />
                        <PasswordBox x:Name="ApiKeyBox" Header="API Key" PlaceholderText="输入密钥"
                                     PasswordRevealMode="Hidden" AutomationProperties.Name="API Key" />
                        <TextBlock x:Name="ApiKeyHint" Text="密钥会在保存时交由应用安全存储。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="TimeoutBox" Header="请求超时（秒）" InputScope="Number"
                                 AutomationProperties.Name="请求超时，单位秒" />
                        <TextBlock Text="连接测试会发送测试请求，可能产生少量费用。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SaveButton" Content="保存设置" Click="Save_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" />
                            <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="20" Height="20"
                                          AutomationProperties.Name="正在处理" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻译结果" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="无法自动回填时，可在这里查看并复制结果。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="100" MaxHeight="260" PlaceholderText="结果会显示在这里"
                                 AutomationProperties.Name="翻译结果" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CopyButton" Content="复制结果" IsEnabled="False" Click="Copy_Click" />
                            <Button x:Name="ApplyButton" Content="应用译文" Visibility="Collapsed" IsEnabled="False" Click="Apply_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
