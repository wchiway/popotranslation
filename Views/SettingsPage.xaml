<Page
    x:Class="popotranslation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView x:Name="Navigation" PaneTitle="PopoTranslation" PaneDisplayMode="Auto"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ServiceNavigation" Content="翻译服务" Icon="Setting" Tag="service" />
            <NavigationViewItem x:Name="TranslationNavigation" Content="翻译设置" Icon="Edit" Tag="translation" />
            <NavigationViewItem x:Name="ResultNavigation" Content="翻译结果" Icon="Document" Tag="result" />
            <NavigationViewItem x:Name="AppNavigation" Content="应用设置" Icon="Manage" Tag="app" />
        </NavigationView.MenuItems>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="StatusBar" Grid.Row="0" Margin="24,16,24,0" IsOpen="True" IsClosable="False"
                     Severity="Informational" Title="准备就绪" Message="保存设置后，使用快捷键开始翻译。" />
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24" HorizontalAlignment="Stretch">
                    <Border x:Name="AppPage" Visibility="Collapsed" Padding="20" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="应用设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="更改后立即保存。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="AppLanguageBox" Header="界面语言" IsEnabled="False" HorizontalAlignment="Stretch" SelectionChanged="AppSettings_SelectionChanged">
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English" Tag="en-US" />
                            </ComboBox>
                            <ComboBox x:Name="AppThemeBox" Header="主题" IsEnabled="False" HorizontalAlignment="Stretch" SelectionChanged="AppSettings_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                            <ToggleSwitch x:Name="NotificationsToggle" Header="通知" IsEnabled="False" OnContent="开启" OffContent="关闭" Toggled="AppSettings_Toggled" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="TranslationPage" Visibility="Collapsed" Spacing="20">
                    <Border x:Name="TranslationCard" Padding="20" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="翻译" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="翻译设置和服务配置一起保存。" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="默认连续按三次空格，翻译整个输入框。" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox x:Name="SourceLanguageBox" Header="源语言" PlaceholderText="自动识别（留空）"
                                     AutomationProperties.Name="源语言，留空自动识别" />
                            <ComboBox x:Name="MachineSourceLanguageBox" Header="源语言" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                      AutomationProperties.Name="源语言">
                                <ComboBoxItem Content="自动识别" Tag="" />
                                <ComboBoxItem Content="简体中文" Tag="简体中文" />
                                <ComboBoxItem Content="繁體中文" Tag="繁體中文" />
                                <ComboBoxItem Content="English" Tag="English" />
                                <ComboBoxItem Content="日本語" Tag="日本語" />
                                <ComboBoxItem Content="한국어" Tag="한국어" />
                                <ComboBoxItem Content="Français" Tag="Français" />
                                <ComboBoxItem Content="Deutsch" Tag="Deutsch" />
                                <ComboBoxItem Content="Español" Tag="Español" />
                                <ComboBoxItem Content="Português" Tag="Português" />
                                <ComboBoxItem Content="Русский" Tag="Русский" />
                            </ComboBox>
                            <ComboBox x:Name="TargetLanguageBox" Header="目标语言" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="目标语言">
                                <ComboBoxItem Content="简体中文" Tag="简体中文" />
                                <ComboBoxItem Content="繁體中文" Tag="繁體中文" />
                                <ComboBoxItem Content="English" Tag="English" />
                                <ComboBoxItem Content="日本語" Tag="日本語" />
                                <ComboBoxItem Content="한국어" Tag="한국어" />
                                <ComboBoxItem Content="Français" Tag="Français" />
                                <ComboBoxItem Content="Deutsch" Tag="Deutsch" />
                                <ComboBoxItem Content="Español" Tag="Español" />
                                <ComboBoxItem Content="Português" Tag="Português" />
                                <ComboBoxItem Content="Русский" Tag="Русский" />
                            </ComboBox>
                            <TextBlock x:Name="MachineStyleHint" Visibility="Collapsed" Text="机器翻译不使用翻译风格设置。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="StyleBox" Header="翻译风格（可选）" PlaceholderText="例如：自然、简洁"
                                     AutomationProperties.Name="翻译风格" />
                            <TextBox x:Name="SelectionHotkeyBox" Header="选区翻译（备用快捷键）" PlaceholderText="例如：Ctrl+Alt+F9"
                                     AutomationProperties.Name="选区翻译备用快捷键" />
                            <TextBox x:Name="WholeHotkeyBox" Header="整框翻译（备用快捷键）" PlaceholderText="例如：Ctrl+Alt+F10"
                                     AutomationProperties.Name="整框翻译备用快捷键" />
                            <TextBlock Text="备用快捷键格式：Ctrl、Alt 或 Shift 加一个字母、数字或 F1–F24（F12 除外）。连续三次空格始终启用。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="使用方式" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="• 连续三次空格：翻译当前输入框。第三次空格会被拦截，不会写入正文。"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="• QQ、微信、Discord、Telegram：优先使用 UI Automation，无法读取时使用剪贴板兼容读取和回填。"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="• 终端：请先选中文本，再使用选区备用快捷键。终端内容只读取，不会自动替换。"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="• 无法自动回填时，可在翻译结果页面查看并复制译文。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="ServiceCard" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻译服务" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="设置当前使用的服务、模型和密钥。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ProfilesBox" Header="当前服务" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="当前服务" SelectionChanged="Profiles_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AddProfileButton" Content="新增服务" Click="AddProfile_Click" />
                            <Button x:Name="DeleteProfileButton" Content="删除服务" Click="DeleteProfile_Click" />
                        </StackPanel>
                        <TextBox x:Name="NameBox" Header="服务名称" PlaceholderText="例如：我的翻译服务"
                                 AutomationProperties.Name="服务名称" />
                        <ComboBox x:Name="ProtocolBox" Header="服务类型" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="服务类型" SelectedIndex="0" SelectionChanged="Protocol_SelectionChanged">
                            <ComboBoxItem Content="OpenAI Chat Completions" Tag="OpenAiChatCompletions" />
                            <ComboBoxItem Content="OpenAI Responses" Tag="OpenAiResponses" />
                            <ComboBoxItem Content="Anthropic Messages" Tag="AnthropicMessages" />
                            <ComboBoxItem Content="Gemini generateContent" Tag="GeminiGenerateContent" />
                            <ComboBoxItem Content="百炼 Qwen-MT" Tag="QwenMt" />
                            <ComboBoxItem Content="阿里云机器翻译" Tag="AlibabaTranslate" />
                            <ComboBoxItem Content="百度翻译" Tag="BaiduTranslate" />
                            <ComboBoxItem Content="有道翻译" Tag="YoudaoTranslate" />
                            <ComboBoxItem Content="DeepL" Tag="DeepLTranslate" />
                        </ComboBox>
                        <TextBox x:Name="BaseUrlBox" Header="Base URL" PlaceholderText="留空使用官方默认地址"
                                 InputScope="Url" AutomationProperties.Name="服务基础地址" TextChanged="BaseUrl_TextChanged" />
                        <ComboBox x:Name="QwenRegionBox" Header="百炼地域" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                  AutomationProperties.Name="百炼地域" SelectionChanged="QwenRegion_SelectionChanged">
                            <ComboBoxItem Content="华北2（北京）" Tag="https://dashscope.aliyuncs.com/compatible-mode/v1" />
                            <ComboBoxItem Content="新加坡" Tag="https://dashscope-intl.aliyuncs.com/compatible-mode/v1" />
                            <ComboBoxItem Content="自定义 Base URL" Tag="custom" />
                        </ComboBox>
                        <TextBlock x:Name="QwenRegionHint" Visibility="Collapsed" Text="API Key 与地域须一致；也可使用业务空间专属 Base URL。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="ModelBox" Header="模型 ID" PlaceholderText="输入服务支持的模型 ID"
                                 AutomationProperties.Name="模型 ID" />
                        <!-- 模型选型：https://docs.bailian.console.aliyun.com/zh/model-studio/machine-translation，查证于 2026-10-28。 -->
                        <ComboBox x:Name="QwenModelBox" Header="模型" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                  AutomationProperties.Name="Qwen-MT 模型">
                            <ComboBoxItem Content="qwen-mt-flash（通用推荐）" Tag="qwen-mt-flash" />
                            <ComboBoxItem Content="qwen-mt-plus（最高质量）" Tag="qwen-mt-plus" />
                            <ComboBoxItem Content="qwen-mt-lite（低延迟）" Tag="qwen-mt-lite" />
                        </ComboBox>
                        <PasswordBox x:Name="ApiKeyBox" Header="API Key" PlaceholderText="输入密钥"
                                     PasswordRevealMode="Hidden" AutomationProperties.Name="API Key" />
                        <TextBlock x:Name="ApiKeyHint" Text="密钥会在保存时交由应用安全存储。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <PasswordBox x:Name="SecondaryKeyBox" Header="应用密钥" PlaceholderText="输入密钥"
                                     PasswordRevealMode="Hidden" Visibility="Collapsed" AutomationProperties.Name="应用密钥" />
                        <TextBlock x:Name="SecondaryKeyHint" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Expander x:Name="AdvancedSettings" Header="高级请求设置" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="0,8,0,0">
                                <TextBlock Text="仅适用于当前 AI 协议。填写 JSON 对象；留空可清除已保存的设置。" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="这些内容可能包含敏感信息，将加密保存在本机。API 密钥请使用上方专用密钥输入框；请勿在此输入密码。" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="CustomHeadersBox" Header="自定义请求头 JSON" PlaceholderText="例如：{}"
                                         AutomationProperties.Name="自定义请求头 JSON" AcceptsReturn="True" TextWrapping="Wrap"
                                         IsSpellCheckEnabled="False" MinHeight="100" MaxHeight="220" />
                                <TextBox x:Name="CustomBodyBox" Header="自定义请求体 JSON" PlaceholderText="例如：{}"
                                         AutomationProperties.Name="自定义请求体 JSON" AcceptsReturn="True" TextWrapping="Wrap"
                                         IsSpellCheckEnabled="False" MinHeight="120" MaxHeight="260" />
                            </StackPanel>
                        </Expander>
                        <TextBox x:Name="TimeoutBox" Header="请求超时（秒）" InputScope="Number"
                                 AutomationProperties.Name="请求超时，单位秒" />
                        <TextBlock Text="连接测试使用简体中文样本翻译为英语，不验证当前语言设置；测试请求可能产生少量费用。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ResultPage" Visibility="Collapsed" Padding="20" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻译结果" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="无法自动回填时，可在这里查看并复制结果。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="110" MaxHeight="300" PlaceholderText="结果会显示在这里"
                                 AutomationProperties.Name="翻译结果" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CopyButton" Content="复制结果" IsEnabled="False" Click="Copy_Click" />
                            <Button x:Name="ApplyButton" Content="应用译文" Visibility="Collapsed" IsEnabled="False" Click="Apply_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border x:Name="ServiceActions" Grid.Row="2" Padding="24,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" />
                    <Button x:Name="SaveButton" Content="保存设置" Click="Save_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="20" Height="20"
                                  AutomationProperties.Name="正在处理" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </NavigationView>
</Page>
